<view class="tile {{isJoker ? 'joker' : ''}} {{selected ? 'selected' : ''}} {{disabled ? 'disabled' : ''}} {{showBest ? 'best' : ''}} {{small ? 'tile-small' : ''}}"
      bindtap="onTap">

  <image class="tile-img" src="{{imgSrc}}" mode="aspectFit" />

  <!-- 危险度标记 -->
  <view wx:if="{{dangerLevel >= 0}}" class="danger-dot danger-{{dangerLevel}}"></view>
</view>
