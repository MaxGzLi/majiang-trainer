/* ===== 牌身：仿真3D象牙效果 ===== */
.tile {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 100rpx;
  background: linear-gradient(180deg, #faf6ee 0%, #ede7d5 60%, #ddd7c4 100%);
  border: 2rpx solid #c8b88a;
  border-radius: 8rpx;
  margin: 4rpx;
  box-shadow: 1rpx 2rpx 0 #b8a878, 2rpx 4rpx 0 #a89868, 3rpx 6rpx 8rpx rgba(0,0,0,0.3);
  transition: transform 0.15s, box-shadow 0.15s;
}

/* 小号牌（牌河用） */
.tile-small {
  width: 48rpx;
  height: 66rpx;
}

/* =========================================
   万字牌：黑色书法数字 + 红色萬
   ========================================= */
.wan-num {
  font-size: 38rpx;
  font-weight: 900;
  color: #1a1a1a;
  line-height: 1;
  font-family: 'STKaiti', 'KaiTi', 'SimSun', serif;
}
.wan-char {
  font-size: 20rpx;
  color: #c62828;
  line-height: 1;
  font-weight: 900;
  font-family: 'STKaiti', 'KaiTi', 'SimSun', serif;
}
.tile-small .wan-num { font-size: 26rpx; }
.tile-small .wan-char { font-size: 14rpx; }

/* =========================================
   筒子牌：绿色/红色圆圈
   ========================================= */

/* 1筒：三层同心圆 */
.one-tong {
  display: flex;
  align-items: center;
  justify-content: center;
}
.one-tong-outer {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #2e7d32;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}
.one-tong-mid {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #c62828;
  display: flex;
  align-items: center;
  justify-content: center;
}
.one-tong-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2e7d32;
}
.tile-small .one-tong-outer { width: 30rpx; height: 30rpx; border-width: 2rpx; }
.tile-small .one-tong-mid { width: 18rpx; height: 18rpx; }
.tile-small .one-tong-inner { width: 8rpx; height: 8rpx; }

/* 2-9筒圆点 */
.dots-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rpx;
}
.dot-row {
  display: flex;
  gap: 3rpx;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #66bb6a, #2e7d32);
  border: 1rpx solid #1b5e20;
}
.tile-small .dot { width: 9rpx; height: 9rpx; }
.tile-small .dots-grid { gap: 2rpx; }
.tile-small .dot-row { gap: 2rpx; }

/* =========================================
   条子牌：绿色竹节图案
   ========================================= */

/* 1条：鸟形简化设计 */
.one-tiao {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}
.bird-head {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c62828;
  margin-bottom: -2rpx;
  z-index: 1;
}
.bird-body {
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(90deg, #43a047, #2e7d32, #43a047);
  border-radius: 2rpx;
  position: relative;
}
.bird-body::before,
.bird-body::after {
  content: '';
  position: absolute;
  left: -2rpx;
  right: -2rpx;
  height: 2rpx;
  background: #1b5e20;
  border-radius: 1rpx;
}
.bird-body::before { top: 8rpx; }
.bird-body::after { bottom: 8rpx; }
.bird-tail {
  width: 16rpx;
  height: 6rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #2e7d32;
  margin-top: -2rpx;
}
.tile-small .bird-head { width: 8rpx; height: 8rpx; }
.tile-small .bird-body { width: 6rpx; height: 24rpx; }
.tile-small .bird-tail { width: 12rpx; height: 4rpx; }

/* 2-9条竹节排列 */
.bars-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rpx;
}
.bar-row {
  display: flex;
  gap: 5rpx;
}
.bar {
  width: 6rpx;
  height: 18rpx;
  background: linear-gradient(90deg, #43a047, #2e7d32, #43a047);
  border-radius: 2rpx;
  position: relative;
}
/* 竹节（横纹） */
.bar::before,
.bar::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #1b5e20;
}
.bar::before { top: 5rpx; }
.bar::after { bottom: 5rpx; }
.tile-small .bar { width: 4rpx; height: 12rpx; }
.tile-small .bars-grid { gap: 2rpx; }
.tile-small .bar-row { gap: 3rpx; }
.tile-small .bar::before { top: 3rpx; }
.tile-small .bar::after { bottom: 3rpx; }

/* =========================================
   风牌：黑色大字
   ========================================= */
.feng-char {
  font-size: 42rpx;
  font-weight: 900;
  color: #1a1a1a;
  font-family: 'STKaiti', 'KaiTi', 'SimSun', serif;
}
.tile-small .feng-char { font-size: 28rpx; }

/* =========================================
   箭牌：中=红 发=绿
   ========================================= */
.jian-char {
  font-size: 44rpx;
  font-weight: 900;
  font-family: 'STKaiti', 'KaiTi', 'SimSun', serif;
}
.jian-zhong { color: #c62828; }
.jian-fa { color: #2e7d32; }
.tile-small .jian-char { font-size: 30rpx; }

/* =========================================
   财神：金色牌身 + 红字
   ========================================= */
.joker {
  background: linear-gradient(180deg, #fff8e1 0%, #ffe082 60%, #ffc107 100%);
  border-color: #f9a825;
  box-shadow: 1rpx 2rpx 0 #f57f17, 2rpx 4rpx 0 #e65100, 3rpx 6rpx 8rpx rgba(0,0,0,0.3);
}
.joker-char {
  font-size: 36rpx;
  font-weight: 900;
  color: #c62828;
  line-height: 1;
  font-family: 'STKaiti', 'KaiTi', 'SimSun', serif;
}
.joker-sub {
  font-size: 18rpx;
  color: #c62828;
  font-weight: bold;
  line-height: 1;
}
.tile-small .joker-char { font-size: 24rpx; }
.tile-small .joker-sub { font-size: 12rpx; }

/* =========================================
   交互状态
   ========================================= */
.selected {
  transform: translateY(-16rpx);
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.4);
  border-color: #e74c3c;
}
.best {
  border-color: #27ae60;
  box-shadow: 0 0 12rpx rgba(39,174,96,0.6);
}
.disabled { opacity: 0.6; }

/* =========================================
   危险度标记（河切模式）
   ========================================= */
.danger-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.danger-0 { background: #4caf50; }
.danger-1 { background: #ff9800; }
.danger-2 { background: #f44336; }
