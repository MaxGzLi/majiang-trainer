<view class="page">
  <!-- Background watermark -->
  <view class="watermark">
    <text class="wm wm1">九萬</text>
    <text class="wm wm2">四筒</text>
    <text class="wm wm3">二萬</text>
    <text class="wm wm4">南</text>
    <text class="wm wm5">一萬</text>
    <text class="wm wm6">發</text>
    <text class="wm wm7">七筒</text>
  </view>

  <!-- Logo -->
  <view class="hero">
    <view class="logo-ring">
      <view class="logo-tile">
        <text class="logo-char">麻</text>
      </view>
    </view>
    <text class="title">杭州麻将训练器</text>
  </view>

  <!-- Cards -->
  <view class="cards">
    <!-- 练习模式 -->
    <navigator url="/pages/practice-menu/practice-menu" hover-class="card-hover" class="card card-practice">
      <view class="card-body">
        <text class="card-badge badge-green">【基础】</text>
        <text class="card-title">练习模式</text>
        <text class="card-desc">何切 / 河切分项练习，三档难度逐步进阶</text>
        <view class="card-footer">
          <text class="card-stat stat-green" wx:if="{{totalPractice > 0}}">已练 {{totalPractice}} 题</text>
          <view class="arrow-btn arrow-green">
            <text class="arrow-text arrow-text-green">→</text>
          </view>
        </view>
      </view>
      <view class="card-deco">
        <view class="deco-target">
          <view class="t-ring t-outer"></view>
          <view class="t-ring t-mid"></view>
          <view class="t-dot"></view>
          <view class="t-arrow"></view>
          <view class="t-arrow-head"></view>
        </view>
      </view>
    </navigator>

    <!-- 对战模式 -->
    <navigator url="/pages/battle-menu/battle-menu" hover-class="card-hover" class="card card-battle">
      <view class="card-body">
        <text class="card-badge badge-brown">【竞技】</text>
        <text class="card-title">对战模式</text>
        <text class="card-desc">连对挑战 / 1v1 实时PK，和牌友一较高下</text>
        <view class="card-footer">
          <text class="card-stat stat-brown" wx:if="{{totalBattle > 0}}">已战 {{totalBattle}} 场</text>
          <view class="arrow-btn arrow-brown">
            <text class="arrow-text arrow-text-brown">→</text>
          </view>
        </view>
      </view>
      <view class="card-deco">
        <view class="deco-swords">
          <view class="sword sword-l"></view>
          <view class="sword sword-r"></view>
          <view class="sword-shield">
            <text class="shield-char">战</text>
          </view>
        </view>
      </view>
    </navigator>
  </view>

  <!-- Bottom -->
  <navigator url="/pages/stats/stats" hover-class="pill-hover" class="bottom-pill">
    <text class="pill-text">查看练习统计 →</text>
  </navigator>

  <!-- Bottom decoration -->
  <view class="bottom-diamond"></view>
</view>
