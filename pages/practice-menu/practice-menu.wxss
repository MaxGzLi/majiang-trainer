page { height: 100%; }
.page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 40rpx 48rpx;
  box-sizing: border-box;
}

.cards { display: flex; flex-direction: column; gap: 28rpx; }

.card {
  background: rgba(255,255,255,0.05);
  border: 2rpx solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

/* Card header */
.card-top {
  display: flex; align-items: center; gap: 20rpx;
  margin-bottom: 28rpx;
}
.card-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: bold; color: #fff;
  flex-shrink: 0;
}
.icon-heqie { background: linear-gradient(135deg, #c8a830, #e8c840); }
.icon-river { background: linear-gradient(135deg, #4080d0, #5c9aff); }

.card-info { display: flex; flex-direction: column; }
.card-title { font-size: 34rpx; font-weight: bold; color: #f0e6d2; }
.card-desc { font-size: 22rpx; color: #8cb89c; margin-top: 6rpx; }

/* Difficulty selector */
.diff-row {
  display: flex; gap: 16rpx;
  margin-bottom: 24rpx;
}
.diff-btn {
  flex: 1;
  min-height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid rgba(168,216,168,0.25);
  border-radius: 12rpx;
  font-size: 26rpx; color: #8cb89c;
  transition: all 0.15s ease;
}
.diff-active {
  background: rgba(168,216,168,0.15);
  border-color: #a8d8a8;
  color: #f0e6d2;
  font-weight: bold;
}

/* Start button */
.start-btn {
  width: 100%;
  min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx;
  font-size: 32rpx; font-weight: bold;
  transition: transform 0.15s ease;
}
.btn-hover { transform: scale(0.97); opacity: 0.85; }
.btn-gold { background: #e8c840; color: #2c1810; }
.btn-blue { background: #5c9aff; color: #fff; }

/* Stats */
.stat-line {
  display: block;
  text-align: center;
  font-size: 22rpx; color: rgba(168,216,168,0.45);
  margin-top: 16rpx;
}
