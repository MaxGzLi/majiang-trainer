page { height: 100%; }
.page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 40rpx 48rpx;
  box-sizing: border-box;
}

.cards { display: flex; flex-direction: column; gap: 28rpx; }

.card {
  background: rgba(255,255,255,0.05);
  border: 2rpx solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

/* Card header */
.card-top {
  display: flex; align-items: center; gap: 20rpx;
  margin-bottom: 24rpx;
}
.card-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: bold; color: #fff;
  flex-shrink: 0;
}
.icon-streak { background: linear-gradient(135deg, #d09030, #e8c840); font-size: 36rpx; }
.icon-pk { background: linear-gradient(135deg, #5050d0, #7c4dff); font-size: 28rpx; letter-spacing: 2rpx; }

.card-info { display: flex; flex-direction: column; }
.card-title { font-size: 34rpx; font-weight: bold; color: #f0e6d2; }
.card-desc { font-size: 22rpx; color: #8cb89c; margin-top: 6rpx; }

/* Details */
.detail-list { margin-bottom: 24rpx; }
.detail-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 6rpx 0;
}
.detail-dot {
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: rgba(168,216,168,0.3);
  flex-shrink: 0;
}
.detail-text { font-size: 23rpx; color: rgba(168,216,168,0.6); }

/* Start button */
.start-btn {
  width: 100%;
  min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx;
  font-size: 32rpx; font-weight: bold;
  transition: transform 0.15s ease;
}
.btn-hover { transform: scale(0.97); opacity: 0.85; }
.btn-streak { background: linear-gradient(135deg, #e8c840, #f0a030); color: #2c1810; }
.btn-pk { background: linear-gradient(135deg, #5c9aff, #7c4dff); color: #fff; }

/* Stats */
.stat-line {
  display: block;
  text-align: center;
  font-size: 22rpx; color: rgba(168,216,168,0.45);
  margin-top: 16rpx;
}
