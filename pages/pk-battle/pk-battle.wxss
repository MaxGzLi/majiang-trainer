.container { padding: 20rpx; }

/* 进度区域 */
.progress-area { margin-bottom: 20rpx; padding: 16rpx; background: rgba(255,255,255,0.06); border-radius: 12rpx; }
.player-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.player-row:last-child { margin-bottom: 0; }
.player-label { font-size: 24rpx; color: #a8d8a8; width: 60rpx; flex-shrink: 0; }
.progress-bar-wrap { flex: 1; height: 20rpx; background: rgba(255,255,255,0.1); border-radius: 10rpx; overflow: hidden; }
.progress-bar { height: 100%; background: #27ae60; border-radius: 10rpx; transition: width 0.3s; min-width: 0; }
.op-bar { background: #5c9aff; }
.player-score { font-size: 24rpx; color: #e8c840; width: 80rpx; text-align: right; flex-shrink: 0; }
.offline-warn { font-size: 22rpx; color: #ff9800; text-align: center; margin-top: 8rpx; }

/* 题号 */
.q-counter { text-align: center; font-size: 24rpx; color: #a8d8a8; margin-bottom: 12rpx; }

/* 题型标签 */
.q-type-tag { display: inline-block; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx; margin-bottom: 12rpx; }
.practice-tag { background: rgba(232,200,64,0.2); color: #e8c840; }
.safety-tag { background: rgba(92,154,255,0.2); color: #5c9aff; }
.discard-tag { background: rgba(255,152,0,0.2); color: #ff9800; }

/* 手牌 */
.prompt { text-align: center; font-size: 26rpx; color: #a8d8a8; margin-bottom: 12rpx; }
.hand { display: flex; flex-wrap: wrap; justify-content: center; padding: 8rpx 0 16rpx; }

/* 牌河 */
.rivers-area { margin-bottom: 12rpx; }
.river-section { background: rgba(255,255,255,0.05); border-radius: 12rpx; padding: 12rpx; margin-bottom: 8rpx; }
.river-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.river-label { font-size: 22rpx; color: #a8d8a8; font-weight: bold; }
.feed-warn { font-size: 20rpx; color: #f44336; font-weight: bold; }
.feed-info { font-size: 20rpx; color: #ff9800; }
.river-tiles { display: flex; flex-wrap: wrap; }
.melds { display: flex; gap: 12rpx; margin-top: 6rpx; padding-top: 6rpx; border-top: 1rpx solid rgba(255,255,255,0.1); }
.meld { display: flex; align-items: center; gap: 4rpx; }
.meld-type { font-size: 18rpx; color: #ff9800; margin-right: 4rpx; }

/* 安全判断题 */
.safety-question { text-align: center; }
.safety-prompt { font-size: 28rpx; color: #f0e6d2; display: block; margin-bottom: 20rpx; }
.target-tile-wrap { display: flex; justify-content: center; margin-bottom: 24rpx; }
.safety-choices { display: flex; justify-content: center; gap: 20rpx; }
.safety-btn { padding: 16rpx 28rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: bold; }
.safety-btn.safe { background: rgba(76,175,80,0.2); color: #4caf50; border: 2rpx solid #4caf50; }
.safety-btn.warn { background: rgba(255,152,0,0.2); color: #ff9800; border: 2rpx solid #ff9800; }
.safety-btn.danger { background: rgba(244,67,54,0.2); color: #f44336; border: 2rpx solid #f44336; }

/* 快速结果 */
.quick-result {
  display: flex; align-items: center; justify-content: center;
  padding: 16rpx; border-radius: 12rpx; margin-top: 12rpx;
  font-size: 40rpx; font-weight: bold;
}
.quick-result.correct { background: rgba(39,174,96,0.2); color: #27ae60; }
.quick-result.wrong { background: rgba(231,76,60,0.2); color: #e74c3c; }

.correct-answer { text-align: center; font-size: 24rpx; color: #f0e6d2; margin-top: 8rpx; padding: 8rpx; background: rgba(255,255,255,0.05); border-radius: 8rpx; }

/* 最终结果 */
.final-result { text-align: center; padding: 80rpx 40rpx; }
.final-text { display: block; font-size: 52rpx; font-weight: bold; margin-bottom: 40rpx; }
.final-result.win .final-text { color: #e8c840; }
.final-result.lose .final-text { color: #e74c3c; }
.final-result.draw .final-text { color: #a8d8a8; }
.final-scores { margin-bottom: 60rpx; }
.final-score-item { display: block; font-size: 30rpx; color: #f0e6d2; margin-bottom: 12rpx; }
.final-actions { display: flex; justify-content: center; }
.back-btn {
  width: 400rpx; padding: 20rpx 0; border: 2rpx solid #a8d8a8;
  color: #a8d8a8; font-size: 32rpx; border-radius: 40rpx; text-align: center;
}
